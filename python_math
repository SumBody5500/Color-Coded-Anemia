import math

def f(x):
    return x**3 - x - 2   # example function

def bisection(a, b, tol=1e-6):
    if f(a) * f(b) >= 0:
        print("Bisection method fails.")
        return None

    while (b - a) / 2 > tol:
        c = (a + b) / 2
        if f(c) == 0:
            return c
        elif f(a) * f(c) < 0:
            b = c
        else:
            a = c

    return (a + b) / 2

root = bisection(1, 2)
print("Root by Bisection Method:", root)
